# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" real para o Git (ele deve estar no .gitignore).

# URL de conexão com o banco PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://postgres:senha@localhost:5432/estoque_db

# Chave secreta usada para assinar os tokens JWT (autenticação)
# Gere uma chave forte, por exemplo com: openssl rand -hex 32
SECRET_KEY=troque_esta_chave_por_uma_chave_secreta_forte

# Algoritmo usado para assinar o JWT
ALGORITHM=HS256

# Tempo de expiração do token de acesso, em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=60
